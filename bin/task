#!/usr/bin/env python3
"""task - file-based task board with agent-neutral local runs.

Tasks are markdown files in <hub>/tasks/. You register tasks (`task new`, or `/task` in an
agent), approve them (`task start`), and at most MAX_PARALLEL run at once on this machine.

A run: task-hub makes a git worktree on branch `task/<id>`, opens it as a herdr workspace
(or a plain background process without herdr), and runs the configured agent CLI there
(claude, codex, pi, kiro, ...). The agent only edits files and writes `.task-report.md`.
task-hub then commits, pushes, opens or updates the PR, and sets the status.

Lifecycle: draft -> ready (approved, queued) -> in_progress -> review -> done  (or blocked).
"""
import configparser
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.3.0"
MAX_PARALLEL = 3
STATUSES = ["draft", "ready", "in_progress", "review", "blocked", "done"]
FIELDS = ["id", "title", "repo", "theme", "agent", "status", "created", "updated",
          "branch", "started", "pid", "workspace", "worktree", "log", "pr", "reason"]
REPORT_FILE = ".task-report.md"
PLACEHOLDER = "(filled in when the agent finishes)"
BODY_TEMPLATE = f"""## Goal

{{goal}}

## Report

{PLACEHOLDER}

## Please review

{PLACEHOLDER}
"""
DEFAULT_AGENTS = {
    "claude": "claude -p --dangerously-skip-permissions {prompt}",
    "codex": "codex exec -s workspace-write {prompt}",
    "pi": "pi -p {prompt}",
    "kiro": "kiro-cli chat --no-interactive --trust-all-tools {prompt}",
}

BIN = Path(__file__).resolve()
HUB = Path(os.environ.get("TASK_HUB_DIR") or BIN.parent.parent)
TASKS = HUB / "tasks"
WORKER_PROMPT = BIN.parent.parent / "worker" / "PROMPT.md"
CONFIG = Path.home() / ".config" / "task-hub" / "config.ini"
DATA = Path.home() / ".local" / "share" / "task-hub"
LOGS = Path.home() / ".local" / "state" / "task-hub" / "logs"
GH = os.environ.get("TASK_GH", "gh")


# ---------- output (TOON) ----------

def q(v):
    s = "" if v is None else str(v)
    if s == "" or s != s.strip() or re.search(r'[,:"\\\[\]{}\n#]', s) or s in ("true", "false", "null") \
            or re.fullmatch(r"-?\d+(\.\d+)?", s):
        return json.dumps(s, ensure_ascii=False)
    return s


def out(*lines):
    print("\n".join(lines), flush=True)


def table(name, rows, cols):
    lines = [f"{name}[{len(rows)}]{{{','.join(cols)}}}:"]
    lines += ["  " + ",".join(q(r.get(c)) for c in cols) for r in rows]
    return lines


def fail(msg, help_=None, code=1):
    out(f"error: {msg}", *([f"help: {help_}"] if help_ else []))
    sys.exit(code)


def home(p):
    return str(p).replace(str(Path.home()), "~")


def run(*cmd, cwd=None, check=False):
    r = subprocess.run([str(c) for c in cmd], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(map(str, cmd[:3]))} failed: {(r.stderr or r.stdout).strip()[-300:]}")
    return r


# ---------- config ----------

def config():
    c = configparser.ConfigParser(inline_comment_prefixes=(";", "#"), interpolation=None)
    c.read_dict({"runner": {"agent": "claude"}, "agents": DEFAULT_AGENTS})
    c.read(CONFIG)
    return c


def agent_command(name, prompt):
    c = config()
    if not c.has_option("agents", name):
        fail(f"unknown agent {name!r}", f"agents: {', '.join(c['agents'])} (add more in {home(CONFIG)})", 2)
    return [prompt if part == "{prompt}" else part for part in shlex.split(c["agents"][name])]


def check_agent(name):
    if name and not config().has_option("agents", name):
        fail(f"unknown agent {name!r}", f"agents: {', '.join(config()['agents'])} (add more in {home(CONFIG)})", 2)


# ---------- task files ----------

def parse(path):
    m = re.match(r"---\n(.*?)\n---\n?(.*)", path.read_text(), re.S)
    if not m:
        fail(f"{path.name} has no frontmatter")
    meta = {}
    for line in m.group(1).splitlines():
        k, _, v = line.partition(":")
        meta[k.strip()] = v.strip()
    meta["_body"], meta["_path"] = m.group(2), path
    return meta


def write(t, msg):
    t["updated"] = today()
    head = "\n".join(f"{k}: {t.get(k, '')}".rstrip() for k in FIELDS)
    t["_path"].write_text(f"---\n{head}\n---\n{t['_body']}")
    # local history only; several runs may finish at once, so retry while git's index is locked
    if run("git", "-C", HUB, "rev-parse").returncode == 0:
        for _ in range(20):
            run("git", "-C", HUB, "add", t["_path"])
            r = run("git", "-C", HUB, "commit", "-q", "-m", f"task {t['id']}: {msg}", "--", t["_path"])
            if "index.lock" not in r.stderr:
                break
            time.sleep(0.2)


def load_all():
    return sorted((parse(p) for p in TASKS.glob("*.md")), key=lambda t: int(t["id"]))


def get(tid):
    if str(tid).isdigit():
        for t in load_all():
            if int(t["id"]) == int(tid):
                return t
    fail(f"task {tid} not found", "task list")


def section(body, name):
    """Text under '## name' up to the next '## ' heading, or ''."""
    m = re.search(rf"(?m)^## {re.escape(name)}[ \t]*\n(.*?)(?=^## |\Z)", body, re.S)
    return m.group(1).strip() if m else ""


def set_section(body, name, text):
    return re.sub(rf"(?m)^(## {re.escape(name)}[ \t]*\n)(.*?)(?=^## |\Z)",
                  lambda m: f"{m.group(1)}\n{text}\n\n", body, count=1, flags=re.S)


def today():
    return datetime.date.today().isoformat()


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40] or "task"


# ---------- herdr ----------

def herdr(*args):
    return run("herdr", *args)


def herdr_available():
    if os.environ.get("TASK_HERDR") == "0" or not shutil.which("herdr"):
        return False
    return "status: running" in herdr("status", "server").stdout


def close_workspace(t):
    if t.get("workspace") and herdr_available():
        herdr("workspace", "close", t["workspace"])


# ---------- starting a run ----------

def clone_dir(repo):
    return DATA / "repos" / repo


def ensure_clone(repo):
    d = clone_dir(repo)
    if not (d / ".git").exists():
        d.parent.mkdir(parents=True, exist_ok=True)
        url = os.environ.get("TASK_CLONE_URL")  # tests: a local bare repo, e.g. file:///tmp/{repo}.git
        if url:
            run("git", "clone", "-q", url.format(repo=repo), d, check=True)
        else:
            # HTTPS authenticated by gh, set on this clone only: works without SSH keys and
            # leaves the user's global git config alone
            run("git", "clone", "-q", "-c", "credential.helper=", "-c", f"credential.helper=!{GH} auth git-credential",
                f"https://github.com/{repo}.git", d, check=True)
    run("git", "-C", d, "fetch", "-q", "--prune", "origin", check=True)
    run("git", "-C", d, "remote", "set-head", "origin", "--auto")
    return d


def ensure_worktree(t):
    """The task's worktree on branch task/<id>; a re-run continues where the last run pushed."""
    repo_dir = ensure_clone(t["repo"])
    wt = DATA / "worktrees" / t["id"]
    if (wt / ".git").exists():
        return wt
    run("git", "-C", repo_dir, "worktree", "prune")
    branch = t["branch"]
    if run("git", "-C", repo_dir, "rev-parse", "--verify", "-q", f"origin/{branch}").returncode == 0:
        base = f"origin/{branch}"
    else:
        base = run("git", "-C", repo_dir, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").stdout.strip() \
            or "origin/main"
    run("git", "-C", repo_dir, "worktree", "add", "-q", "-B", branch, wt, base, check=True)
    exclude = Path(run("git", "-C", wt, "rev-parse", "--git-common-dir").stdout.strip())
    exclude = (exclude if exclude.is_absolute() else wt / exclude) / "info" / "exclude"
    if REPORT_FILE not in (exclude.read_text() if exclude.exists() else ""):
        exclude.parent.mkdir(parents=True, exist_ok=True)
        with exclude.open("a") as f:
            f.write(f"\n{REPORT_FILE}\n")
    return wt


def launch(t):
    """Start `task _run <id>` in a herdr workspace, or as a background process."""
    t["branch"] = t.get("branch") or f"task/{t['id']}"
    t["agent"] = t.get("agent") or config()["runner"]["agent"]
    wt = ensure_worktree(t)
    LOGS.mkdir(parents=True, exist_ok=True)
    t["worktree"], t["log"], t["started"], t["pid"] = str(wt), str(LOGS / f"{t['id']}.log"), now(), ""
    prompt_file(t).parent.mkdir(parents=True, exist_ok=True)
    prompt_file(t).write_text(build_prompt(t))  # kept, so you can always see what the agent was told
    cmd = [sys.executable, str(BIN), "_run", t["id"]]
    if herdr_available():
        close_workspace(t)  # a re-run replaces this task's old workspace, never anyone else's
        r = herdr("workspace", "create", "--cwd", wt, "--label", f"task {t['id']}: {t['title']}"[:60], "--no-focus")
        if r.returncode != 0:
            raise RuntimeError(f"herdr could not create a workspace: {r.stderr.strip()[-200:]}")
        res = json.loads(r.stdout)["result"]
        t["workspace"] = res["workspace"]["workspace_id"]
        t["status"], t["reason"] = "in_progress", ""
        write(t, "started")  # saved before the run starts: the run reads it, then records its pid
        # the pane's shell starts with the herdr server's environment, not ours: a small launcher
        # carries over what the run depends on (config/data under HOME, agents on PATH, settings)
        keep = {k: v for k, v in os.environ.items()
                if k in ("HOME", "PATH") or k.startswith(("TASK_", "GIT_AUTHOR_", "GIT_COMMITTER_"))}
        launcher = DATA / "run" / f"{t['id']}.sh"
        launcher.parent.mkdir(parents=True, exist_ok=True)
        launcher.write_text("#!/bin/sh\nexec " + shlex.join(["env", *(f"{k}={v}" for k, v in keep.items()), *cmd]) + "\n")
        pane = res["root_pane"]["pane_id"]
        herdr("pane", "run", pane, shlex.join(["sh", str(launcher)]))
        # a brand-new shell can swallow the Enter while it is still starting up: confirm the run began
        for retry in (False, True):
            if retry:
                herdr("pane", "send-keys", pane, "enter")
            if herdr("pane", "wait-output", pane, "--match", f"== task {t['id']}:", "--timeout", "8000").returncode == 0:
                break
        else:
            raise RuntimeError(f"the run did not start in herdr workspace {t['workspace']}")
    else:
        t["workspace"] = ""
        t["status"], t["reason"] = "in_progress", ""
        write(t, "started")
        with open(t["log"], "ab") as log:
            subprocess.Popen(cmd, cwd=wt, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                             start_new_session=True, env={**os.environ, "TASK_RUN_LOGGED": "1"})


# ---------- one run (called in the herdr pane or background process) ----------

def prompt_file(t):
    return DATA / "prompts" / f"{t['id']}.md"


def build_prompt(t):
    instructions = WORKER_PROMPT.read_text().split("\n---\n", 1)[-1].strip()
    lines = [instructions, "", "# Your task", "", f"Task {t['id']}: {t['title']}", f"Repository: {t['repo']}",
             f"Branch: {t['branch']} (already checked out in the current directory)", "",
             section(t["_body"], "Goal")]
    previous = section(t["_body"], "Report")
    if previous and previous != PLACEHOLDER:
        lines += ["", "# Earlier run", "", "An earlier run of this task stopped. Its report:", "", previous]
        if t.get("reason"):
            lines += ["", f"It was blocked because: {t['reason']}"]
    return "\n".join(lines) + "\n"


def cmd_run(a):
    t = get(a["id"])
    t["pid"] = str(os.getpid())
    write(t, "run started")
    log = None if os.environ.get("TASK_RUN_LOGGED") else open(t["log"], "a")

    def say(line):
        print(line, flush=True)
        if log:
            log.write(line + "\n")
            log.flush()

    wt = Path(t["worktree"])
    (wt / REPORT_FILE).unlink(missing_ok=True)
    say(f"== task {t['id']}: {t['title']} | agent {t['agent']} | {now()}")
    try:
        proc = subprocess.Popen(agent_command(t["agent"], prompt_file(t).read_text()), cwd=wt, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            say(line.rstrip("\n"))
        code = proc.wait()
    except KeyboardInterrupt:  # Ctrl-C in the pane stops the agent; still push what it did
        proc.terminate()
        code = proc.wait()
        say("== stopped with Ctrl-C")
    except FileNotFoundError as e:
        code, _ = 127, say(f"agent not found: {e}")
    say(f"== agent exited with code {code}")

    t = get(a["id"])
    report = (wt / REPORT_FILE).read_text() if (wt / REPORT_FILE).exists() else ""
    (wt / REPORT_FILE).unlink(missing_ok=True)
    try:
        finish(t, report, code, say)
    except RuntimeError as e:
        t["status"], t["reason"] = "blocked", str(e)[:200]
        write(t, "blocked (runner error)")
        say(f"== blocked: {e}")
    t["pid"] = ""
    write(t, "run finished")
    say(f"== task {t['id']} is now {t['status']}. This pane stays open; `task done {t['id']}` closes it.")


def finish(t, report, code, say):
    for name in ("Report", "Please review"):
        if section(report, name):
            t["_body"] = set_section(t["_body"], name, section(report, name))
    blocked = section(report, "Blocked").splitlines()
    wt = t["worktree"]
    run("git", "-C", wt, "add", "-A", check=True)
    if run("git", "-C", wt, "diff", "--cached", "--quiet").returncode != 0:
        run("git", "-C", wt, "commit", "-q", "-m", f"task {t['id']}: {t['title']}", check=True)
    base = run("git", "-C", wt, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").stdout.strip() or "origin/main"
    ahead = run("git", "-C", wt, "rev-list", "--count", f"{base}..HEAD").stdout.strip()

    if not report.strip():
        t["status"], t["reason"] = "blocked", f"agent exited without a report (exit {code}), see log"
    elif not blocked and ahead in ("", "0"):
        t["status"], t["reason"] = "blocked", "agent wrote a report but changed no files"
    if ahead in ("", "0"):  # nothing to push, so no PR (GitHub refuses one without commits)
        if blocked:
            t["status"], t["reason"] = "blocked", blocked[0]
        write(t, "blocked")
        return

    run("git", "-C", wt, "push", "-q", "-u", "origin", f"HEAD:{t['branch']}", check=True)
    why = blocked[0] if blocked else (t["reason"] if t.get("status") == "blocked" else "")
    draft = bool(why)
    body = "\n\n".join(
        [f"## Blocked\n\n{why}"] * draft +
        [f"## {n}\n\n{section(t['_body'], n)}" for n in ("Report", "Please review")] +
        [f"<sub>task-hub task {t['id']} | agent: {t['agent']}</sub>"])
    t["pr"] = upsert_pr(t, body, draft, base.split("/", 1)[-1])
    if blocked:
        t["status"], t["reason"] = "blocked", blocked[0]
    elif t.get("status") != "blocked":
        t["status"], t["reason"] = "review", ""
    write(t, t["status"])
    say(f"== PR: {t['pr']}")


def upsert_pr(t, body, draft, base):
    pr = find_pr(t)
    body_file = DATA / f"pr-body-{t['id']}.md"
    body_file.write_text(body)
    if pr is None or pr["state"] != "OPEN":
        r = run(GH, "pr", "create", "--repo", t["repo"], "--head", t["branch"], "--base", base,
                "--title", t["title"], "--body-file", body_file, *(["--draft"] if draft else []), check=True)
        url = r.stdout.strip().splitlines()[-1]
    else:
        url = pr["url"]
        run(GH, "pr", "edit", url, "--body-file", body_file, check=True)
        if pr["isDraft"] != draft:
            run(GH, "pr", "ready", url, *(["--undo"] if draft else []), check=True)
    body_file.unlink(missing_ok=True)
    return url


# ---------- GitHub (reading) ----------

def find_pr(t):
    r = run(GH, "pr", "list", "--repo", t["repo"], "--head", t["branch"], "--state", "all",
            "--limit", "1", "--json", "url,state,isDraft")
    if r.returncode != 0:
        raise RuntimeError(((r.stderr or r.stdout).strip().splitlines() or ["gh failed"])[-1])
    prs = json.loads(r.stdout or "[]")
    return prs[0] if prs else None


def alive(t):
    if not t.get("pid"):
        # launched but `_run` has not recorded itself yet; give it two minutes
        started = datetime.datetime.strptime(t.get("started") or now(), "%Y-%m-%dT%H:%M:%SZ")
        started = started.replace(tzinfo=datetime.timezone.utc)
        return (datetime.datetime.now(datetime.timezone.utc) - started).total_seconds() < 120
    r = run("ps", "-p", t["pid"], "-o", "command=")
    return r.returncode == 0 and "_run" in r.stdout


def cleanup(t):
    """Close this task's herdr workspace and remove its worktree (only ones task-hub created)."""
    close_workspace(t)
    wt = Path(t.get("worktree") or "")
    if t.get("worktree") and (DATA / "worktrees") in wt.parents and wt.exists():
        run("git", "-C", clone_dir(t["repo"]), "worktree", "remove", "--force", wt)
    t["workspace"] = ""


# ---------- sync: PRs and runs in, new runs out ----------

def sync():
    lines, changed, errors = [], [], []
    for t in load_all():
        before = t["status"]
        try:
            if before in ("review", "blocked") and t.get("pr"):
                pr = find_pr(t)
                if pr and pr["state"] == "MERGED":
                    cleanup(t)
                    t["status"], t["reason"] = "done", ""
                elif pr and pr["state"] == "CLOSED" and before == "review":
                    t["status"], t["reason"] = "blocked", "PR was closed without merging"
            elif before == "in_progress" and not alive(t):
                t["status"], t["reason"] = "blocked", f"run stopped unexpectedly, see {home(t.get('log'))}"
        except RuntimeError as e:
            errors.append({"id": t["id"], "error": str(e)})
            continue
        if t["status"] != before:
            write(t, f"{t['status']} (sync)")
            changed.append({"id": t["id"], "title": t["title"], "now": t["status"]})
    if changed:
        lines += table("updated", changed, ["id", "title", "now"])
    if errors:
        lines += table("github_errors", errors, ["id", "error"])

    tasks = load_all()
    free = MAX_PARALLEL - sum(t["status"] == "in_progress" for t in tasks)
    ready = [t for t in tasks if t["status"] == "ready"]
    if ready and free <= 0:
        lines.append(f"queue: {len(ready)} approved task(s) waiting, all {MAX_PARALLEL} slots busy")
    started = []
    for t in ready[:max(free, 0)]:
        try:
            launch(t)  # saves the task as in_progress itself; never write it after this (the run owns it)
        except RuntimeError as e:
            t = get(t["id"])
            t["status"], t["reason"] = "blocked", f"could not start: {e}"[:200]
            write(t, "could not start")
            lines.append(f"error: task {t['id']} could not start: {e}")
            continue
        started.append({"id": t["id"], "agent": t["agent"],
                        "where": f"herdr workspace {t['workspace']}" if t["workspace"] else home(t["log"])})
    if started:
        lines += table("started", started, ["id", "agent", "where"])
    return lines


# ---------- commands ----------

def cmd_home(_):
    lines = sync()
    tasks = load_all()
    counts = {s: sum(t["status"] == s for t in tasks) for s in STATUSES}
    active = [t for t in tasks if t["status"] != "done"]
    out(f"bin: {home(BIN)}",
        f"description: File-based task board; approved tasks run as local agents, max {MAX_PARALLEL} at once",
        f"hub: {home(HUB)}",
        "counts: " + ", ".join(f"{s}={n}" for s, n in counts.items()), *lines)
    out(*table("tasks", active, ["id", "title", "status", "agent"]) if active else ["tasks: 0 open tasks"])
    needs_you = counts["draft"] + counts["review"] + counts["blocked"]
    out("help[3]:",
        f"  {needs_you} task(s) need you (draft to approve, review, blocked)",
        "  Run `task show <id>` for details and the report",
        "  Run `task start` to approve a draft (or re-run a blocked task)")


def cmd_list(a):
    tasks = load_all()
    if a["status"]:
        tasks = [t for t in tasks if t["status"] == a["status"]]
    if not tasks:
        out(f"tasks: 0 tasks{' with status ' + a['status'] if a['status'] else ''}")
        return
    out(*table("tasks", tasks, ["id", "title", "status", "agent"]))


def cmd_show(a):
    t = get(a["id"])
    body = t["_body"].strip()
    lines = ["task:"] + [f"  {k}: {q(t.get(k))}" for k in FIELDS if t.get(k)]
    lines.append(f"  file: {t['_path'].relative_to(HUB)}")
    if len(body) > 1500 and not a["full"]:
        lines += ["body: |", *("  " + l for l in body[:1500].splitlines()),
                  f"  ... (truncated, {len(body)} chars total)",
                  f"help: Run `task show {t['id']} --full` for the full body"]
    else:
        lines += ["body: |", *("  " + l for l in body.splitlines())]
    out(*lines)


def cmd_log(a):
    t = get(a["id"])
    if not t.get("log") or not Path(t["log"]).exists():
        out(f"log: task {t['id']} has not run yet")
        return
    lines = Path(t["log"]).read_text(errors="replace").splitlines()
    shown = lines if a["full"] else lines[-40:]
    out(f"log: {home(t['log'])} ({len(lines)} lines)", *shown,
        *([f"help: Run `task log {t['id']} --full` for all lines"] if len(lines) > len(shown) else []))


def cmd_new(a):
    if not a["title"] or not a["repo"]:
        fail("--title and --repo are required",
             'task new --title "..." --repo owner/name [--agent name] [--theme x] (--goal "..." | --goal-file path)', 2)
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", a["repo"]):
        fail(f"--repo must look like owner/name, got {a['repo']!r}", code=2)
    check_agent(a["agent"])
    goal = Path(a["goal_file"]).read_text() if a["goal_file"] else (a["goal"] or "")
    if not goal.strip():
        fail("goal is empty", "pass --goal \"...\" or --goal-file path", 2)
    # keep Goal's own headings below the task's "## " sections
    goal = re.sub(r"(?m)^#{1,2} ", "### ", goal)
    TASKS.mkdir(exist_ok=True)
    tid = max((int(t["id"]) for t in load_all()), default=0) + 1
    path = TASKS / f"{tid:04d}-{slug(a['title'])}.md"
    t = {"id": str(tid), "title": a["title"], "repo": a["repo"], "theme": a["theme"] or "",
         "agent": a["agent"] or "", "status": "draft", "created": today(), "_path": path,
         "_body": BODY_TEMPLATE.format(goal=goal.strip())}
    write(t, "new draft")
    out("task:", f"  id: {tid}", "  status: draft", f"  file: {path.relative_to(HUB)}",
        "help[1]:", "  Run `task start` when you want an agent to pick it up")


def pick(candidates):
    """Let the human choose a task in the terminal: fzf if installed, else a numbered menu."""
    if shutil.which("fzf"):
        lines = "\n".join(f"{t['id']}\t{t['status']:<8}\t{t['title']}\t{t['repo']}" for t in candidates)
        r = subprocess.run(["fzf", "--height", "40%", "--reverse", "--prompt", "start task> ",
                            "--delimiter", "\t", "--with-nth", "2.."], input=lines, stdout=subprocess.PIPE, text=True)
        return r.stdout.split("\t", 1)[0].strip() or None
    for n, t in enumerate(candidates, 1):
        print(f"  {n}) #{t['id']} [{t['status']}] {t['title']} ({t['repo']})")
    choice = input("start which? (number, empty to cancel): ").strip()
    return candidates[int(choice) - 1]["id"] if choice.isdigit() and 0 < int(choice) <= len(candidates) else None


def cmd_start(a):
    check_agent(a["agent"])
    tid = a.get("id")
    if tid is None:
        candidates = [t for t in load_all() if t["status"] in ("draft", "blocked")]
        if not candidates:
            out("start: 0 drafts or blocked tasks to start")
            return
        if len(candidates) == 1:
            tid = candidates[0]["id"]
        elif sys.stdin.isatty() and sys.stdout.isatty():
            tid = pick(candidates)
            if not tid:
                out("start: cancelled")
                return
        else:
            out(*table("candidates", candidates, ["id", "title", "status"]))
            fail("several tasks can be started; say which", "task start <id>", 2)
    t = get(tid)
    if t["status"] in ("ready", "in_progress") and not a["agent"]:
        out(f"task: #{t['id']} already {t['status']} (no-op)")
        return
    if t["status"] not in ("draft", "blocked", "ready"):
        fail(f"task {t['id']} is {t['status']}; only draft or blocked tasks can be started")
    t["status"] = "ready"  # reason is kept until launch: the re-run's prompt tells the agent why it was blocked
    if a["agent"]:
        t["agent"] = a["agent"]
    write(t, "approved")
    lines = sync()
    t = get(t["id"])
    out("task:", f"  id: {t['id']}", f"  title: {q(t['title'])}", f"  status: {t['status']}", *lines)


def cmd_done(a):
    t = get(a["id"])
    if t["status"] == "done":
        out(f"task: #{t['id']} already done (no-op)")
        return
    if t["status"] == "in_progress" and alive(t):
        fail(f"task {t['id']} is still running", "stop the agent in its herdr workspace first, then retry")
    cleanup(t)
    t["status"], t["reason"], t["pid"] = "done", "", ""
    write(t, "done")
    out("task:", f"  id: {t['id']}", "  status: done")


COMMANDS = {
    # name: (handler, positional args (optional ones end with ?), flags(name -> takes_value), help)
    "start": (cmd_start, ["id?"], {"agent": True},
              "task start [<id>] [--agent name]  # approve a draft or re-run a blocked task; no id = pick one"),
    "list": (cmd_list, [], {"status": True}, "task list [--status draft|ready|in_progress|review|blocked|done]"),
    "show": (cmd_show, ["id"], {"full": False}, "task show <id> [--full]"),
    "log": (cmd_log, ["id"], {"full": False}, "task log <id> [--full]  # the run's output"),
    "new": (cmd_new, [], {"title": True, "repo": True, "agent": True, "theme": True, "goal": True, "goal-file": True},
            'task new --title "..." --repo owner/name [--agent name] [--theme x] (--goal "..." | --goal-file path)'),
    "done": (cmd_done, ["id"], {}, "task done <id>  # close or cancel by hand (a merged PR closes it automatically)"),
    "_run": (cmd_run, ["id"], {}, "task _run <id>  # internal: one agent run, started by task-hub"),
}


def main(argv):
    if argv in (["-v"], ["-V"], ["--version"]):
        print(VERSION)
        return
    if not argv:
        return cmd_home(None)
    if argv[0] in ("-h", "--help", "help"):
        out("commands:", "  task  # sync, then show the board",
            *("  " + c[3] for n, c in COMMANDS.items() if not n.startswith("_")))
        return
    name, rest = argv[0], argv[1:]
    if name not in COMMANDS:
        fail(f"unknown command {name!r}", "commands: " + ", ".join(n for n in COMMANDS if not n.startswith("_")), 2)
    handler, positional, flags, usage = COMMANDS[name]
    if "--help" in rest:
        out(f"usage: {usage}")
        return
    a = {f.replace("-", "_"): (None if takes else False) for f, takes in flags.items()}
    pos = []
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok.startswith("--"):
            f = tok[2:]
            if f not in flags:
                fail(f"unknown flag {tok} for `{name}`", f"usage: {usage}", 2)
            if flags[f]:
                if i + 1 >= len(rest):
                    fail(f"{tok} needs a value", f"usage: {usage}", 2)
                a[f.replace("-", "_")] = rest[i + 1]
                i += 1
            else:
                a[f.replace("-", "_")] = True
        else:
            pos.append(tok)
        i += 1
    required = [p for p in positional if not p.endswith("?")]
    if not len(required) <= len(pos) <= len(positional):
        fail(f"`{name}` takes {len(positional)} argument(s), got {len(pos)}", f"usage: {usage}", 2)
    a.update(zip((p.rstrip("?") for p in positional), pos))
    if a.get("status") and a["status"] not in STATUSES:
        fail(f"unknown status {a['status']!r}", "statuses: " + ", ".join(STATUSES), 2)
    handler(a)


if __name__ == "__main__":
    main(sys.argv[1:])
