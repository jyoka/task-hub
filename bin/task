#!/usr/bin/env python3
"""task - file-based task board for cloud coding agents.

Tasks are markdown files in <hub>/tasks/. Only this CLI, on your Mac, writes them.
Cloud agents never touch the board: each one gets the task brief when its run starts,
works on its own branch `claude/task-<id>` in the project repo, and opens a PR.
`task` (or `task sync`) reads those PRs from GitHub to update statuses, then starts
runs for ready tasks while fewer than MAX_PARALLEL are running.

Lifecycle: draft -> ready -> in_progress -> review -> done  (or blocked).
"""
import datetime
import json
import os
import re
import subprocess
import sys
import urllib.request
from pathlib import Path

VERSION = "0.2.0"
MAX_PARALLEL = 3
STATUSES = ["draft", "ready", "in_progress", "review", "blocked", "done"]
FIELDS = ["id", "title", "repo", "theme", "status", "created", "updated",
          "branch", "started", "session", "pr", "reason"]
REPORT_SECTIONS = ["Report", "Please review"]
BODY_TEMPLATE = """## Goal

{goal}

## Report

(filled in from the agent's pull request)

## Please review

(filled in from the agent's pull request)
"""

HUB = Path(os.environ.get("TASK_HUB_DIR") or Path(__file__).resolve().parent.parent)
TASKS = HUB / "tasks"
ROUTINE_ENV = Path.home() / ".config" / "task-hub" / "routine.env"
GH = os.environ.get("TASK_GH", "gh")


# ---------- output (TOON) ----------

def q(v):
    s = "" if v is None else str(v)
    if s == "" or s != s.strip() or re.search(r'[,:"\\\[\]{}\n#]', s) or s in ("true", "false", "null") \
            or re.fullmatch(r"-?\d+(\.\d+)?", s):
        return json.dumps(s, ensure_ascii=False)
    return s


def out(*lines):
    print("\n".join(lines))


def table(name, rows, cols):
    lines = [f"{name}[{len(rows)}]{{{','.join(cols)}}}:"]
    lines += ["  " + ",".join(q(r.get(c)) for c in cols) for r in rows]
    return lines


def fail(msg, help_=None, code=1):
    out(f"error: {msg}", *([f"help: {help_}"] if help_ else []))
    sys.exit(code)


def home(p):
    return str(p).replace(str(Path.home()), "~")


# ---------- task files ----------

def parse(path):
    m = re.match(r"---\n(.*?)\n---\n?(.*)", path.read_text(), re.S)
    if not m:
        fail(f"{path.name} has no frontmatter")
    meta = {}
    for line in m.group(1).splitlines():
        k, _, v = line.partition(":")
        meta[k.strip()] = v.strip()
    meta["_body"], meta["_path"] = m.group(2), path
    return meta


def write(t, msg):
    t["updated"] = today()
    head = "\n".join(f"{k}: {t.get(k, '')}".rstrip() for k in FIELDS)
    t["_path"].write_text(f"---\n{head}\n---\n{t['_body']}")
    # local history only; the hub is never pushed by this CLI
    if subprocess.run(["git", "-C", str(HUB), "rev-parse"], capture_output=True).returncode == 0:
        subprocess.run(["git", "-C", str(HUB), "add", str(t["_path"])], capture_output=True)
        subprocess.run(["git", "-C", str(HUB), "commit", "-q", "-m", f"task {t['id']}: {msg}"],
                       capture_output=True)


def load_all():
    return sorted((parse(p) for p in TASKS.glob("*.md")), key=lambda t: int(t["id"]))


def get(tid):
    if str(tid).isdigit():
        for t in load_all():
            if int(t["id"]) == int(tid):
                return t
    fail(f"task {tid} not found", "task list")


def section(body, name):
    """Text under '## name' up to the next '## ' heading, or ''."""
    m = re.search(rf"(?m)^## {re.escape(name)}[ \t]*\n(.*?)(?=^## |\Z)", body, re.S)
    return m.group(1).strip() if m else ""


def set_section(body, name, text):
    return re.sub(rf"(?m)^(## {re.escape(name)}[ \t]*\n)(.*?)(?=^## |\Z)",
                  lambda m: f"{m.group(1)}\n{text}\n\n", body, count=1, flags=re.S)


def today():
    return datetime.date.today().isoformat()


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40] or "task"


# ---------- GitHub (read-only) ----------

def find_pr(t):
    """The PR for this task's branch, as a dict, or None. Raises RuntimeError if gh fails."""
    r = subprocess.run([GH, "pr", "list", "--repo", t["repo"], "--head", t["branch"], "--state", "all",
                        "--limit", "1", "--json", "url,state,isDraft,updatedAt,body"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1:] or ["gh failed"])
    prs = json.loads(r.stdout or "[]")
    return prs[0] if prs else None


def apply_pr(t, pr):
    """Move a task according to its PR. Returns a short description of the change, or None."""
    if pr is None:
        return None
    if pr["state"] == "MERGED":
        t["status"], t["pr"], t["reason"] = "done", pr["url"], ""
        write(t, "done (PR merged)")
        return "done (PR merged)"
    # only a running task moves on its PR, and only on PR activity after this run started
    # (a re-queued task still has its old draft PR until the new run updates it)
    if t["status"] != "in_progress" or pr["updatedAt"] < t.get("started", ""):
        return None
    for name in REPORT_SECTIONS:
        text = section(pr["body"] or "", name)
        if text:
            t["_body"] = set_section(t["_body"], name, text)
    t["pr"] = pr["url"]
    if pr["state"] == "CLOSED":
        t["status"], t["reason"] = "blocked", "PR was closed without merging"
    elif pr["isDraft"]:
        t["status"] = "blocked"
        t["reason"] = (section(pr["body"] or "", "Blocked").splitlines() or ["agent needs you, see the PR"])[0]
    else:
        t["status"], t["reason"] = "review", ""
    write(t, f"{t['status']} (from PR)")
    return t["status"]


# ---------- routine trigger ----------

def routine_config():
    cfg = {k: os.environ.get(k) for k in ("TASK_ROUTINE_URL", "TASK_ROUTINE_TOKEN")}
    if ROUTINE_ENV.exists():
        for line in ROUTINE_ENV.read_text().splitlines():
            k, _, v = line.partition("=")
            if k.strip() in cfg and not cfg[k.strip()]:
                cfg[k.strip()] = v.strip()
    return cfg if all(cfg.values()) else None


def brief(t):
    return (f"task-hub task {t['id']}\nrepo: {t['repo']}\nbranch: {t['branch']}\n"
            f"title: {t['title']}\n\n{section(t['_body'], 'Goal')}\n")


def fire(cfg, t):
    req = urllib.request.Request(
        cfg["TASK_ROUTINE_URL"], method="POST",
        data=json.dumps({"text": brief(t)}).encode(),
        headers={"Authorization": f"Bearer {cfg['TASK_ROUTINE_TOKEN']}",
                 "anthropic-beta": "experimental-cc-routine-2026-04-01",
                 "anthropic-version": "2023-06-01", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r).get("claude_code_session_url", "")


# ---------- sync: PRs in, runs out ----------

def sync():
    """Update statuses from PRs, then start runs for ready tasks. Returns output lines."""
    lines, changed, errors = [], [], []
    for t in load_all():
        if t["status"] in ("in_progress", "blocked", "review") and t.get("branch"):
            try:
                what = apply_pr(t, find_pr(t))
            except RuntimeError as e:
                errors.append({"id": t["id"], "error": str(e)})
                continue
            if what:
                changed.append({"id": t["id"], "title": t["title"], "now": what})
    if changed:
        lines += table("updated", changed, ["id", "title", "now"])
    if errors:
        lines += table("github_errors", errors, ["id", "error"])

    tasks = load_all()
    free = MAX_PARALLEL - sum(t["status"] == "in_progress" for t in tasks)
    ready = [t for t in tasks if t["status"] == "ready"]
    if not ready:
        return lines
    if free <= 0:
        return lines + [f"dispatch: {len(ready)} ready task(s) waiting, all {MAX_PARALLEL} slots busy"]
    cfg = routine_config()
    if not cfg:
        return lines + [f"dispatch: skipped, routine not configured ({len(ready)} ready task(s) waiting)",
                        f"help: put TASK_ROUTINE_URL and TASK_ROUTINE_TOKEN in {home(ROUTINE_ENV)}"]
    started = []
    for t in ready[:free]:
        t["branch"] = t.get("branch") or f"claude/task-{t['id']}"
        t["started"] = now()
        try:
            t["session"] = fire(cfg, t)
        except Exception as e:
            write(t, "dispatch failed")
            return lines + (table("started", started, ["id", "session"]) if started else []) + [
                f"error: could not start the routine for task {t['id']}: {e}",
                "help: check the routine URL/token, then run `task sync`"]
        t["status"], t["reason"] = "in_progress", ""
        write(t, "started")
        started.append({"id": t["id"], "session": t["session"]})
    return lines + table("started", started, ["id", "session"])


# ---------- commands ----------

def cmd_home(_):
    lines = sync()
    tasks = load_all()
    counts = {s: sum(t["status"] == s for t in tasks) for s in STATUSES}
    active = [t for t in tasks if t["status"] != "done"]
    out(f"bin: {home(Path(__file__).resolve())}",
        f"description: File-based task board; cloud agents work ready tasks, max {MAX_PARALLEL} at once",
        f"hub: {home(HUB)}",
        "counts: " + ", ".join(f"{s}={n}" for s, n in counts.items()), *lines)
    out(*table("tasks", active, ["id", "title", "status", "repo"]) if active else ["tasks: 0 open tasks"])
    needs_you = counts["draft"] + counts["review"] + counts["blocked"]
    out("help[3]:",
        f"  {needs_you} task(s) need you (draft to approve, review, blocked)",
        "  Run `task show <id>` for details",
        "  Run `task ready <id>` to approve a draft for the agents")


def cmd_sync(_):
    lines = sync()
    out(*(lines or ["sync: nothing changed, nothing to start"]))


def cmd_list(a):
    tasks = load_all()
    if a["status"]:
        tasks = [t for t in tasks if t["status"] == a["status"]]
    if not tasks:
        out(f"tasks: 0 tasks{' with status ' + a['status'] if a['status'] else ''}")
        return
    out(*table("tasks", tasks, ["id", "title", "status", "repo"]))


def cmd_show(a):
    t = get(a["id"])
    body = t["_body"].strip()
    lines = ["task:"] + [f"  {k}: {q(t.get(k))}" for k in FIELDS if t.get(k)]
    lines.append(f"  file: {t['_path'].relative_to(HUB)}")
    if len(body) > 1500 and not a["full"]:
        lines += ["body: |", *("  " + l for l in body[:1500].splitlines()),
                  f"  ... (truncated, {len(body)} chars total)",
                  f"help: Run `task show {t['id']} --full` for the full body"]
    else:
        lines += ["body: |", *("  " + l for l in body.splitlines())]
    out(*lines)


def cmd_new(a):
    if not a["title"] or not a["repo"]:
        fail("--title and --repo are required",
             'task new --title "..." --repo owner/name [--theme x] (--goal "..." | --goal-file path)', 2)
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", a["repo"]):
        fail(f"--repo must look like owner/name, got {a['repo']!r}", code=2)
    goal = Path(a["goal_file"]).read_text() if a["goal_file"] else (a["goal"] or "")
    if not goal.strip():
        fail("goal is empty", "pass --goal \"...\" or --goal-file path", 2)
    # keep Goal's own headings below the task's "## " sections
    goal = re.sub(r"(?m)^#{1,2} ", "### ", goal)
    TASKS.mkdir(exist_ok=True)
    tid = max((int(t["id"]) for t in load_all()), default=0) + 1
    path = TASKS / f"{tid:04d}-{slug(a['title'])}.md"
    t = {"id": str(tid), "title": a["title"], "repo": a["repo"], "theme": a["theme"] or "",
         "status": "draft", "created": today(), "_path": path,
         "_body": BODY_TEMPLATE.format(goal=goal.strip())}
    write(t, "new draft")
    out("task:", f"  id: {tid}", "  status: draft", f"  file: {path.relative_to(HUB)}",
        "help[1]:", f"  Run `task ready {tid}` when you want an agent to pick it up")


def set_status(a, new, allowed_from, msg, extra=None):
    t = get(a["id"])
    if t["status"] == new:
        out(f"task: #{t['id']} already {new} (no-op)")
        return None
    if t["status"] not in allowed_from:
        fail(f"task {t['id']} is {t['status']}; {new} only allowed from {', '.join(allowed_from)}")
    t["status"] = new
    t.update(extra or {})
    write(t, msg)
    out("task:", f"  id: {t['id']}", f"  status: {new}")
    return t


def cmd_ready(a):
    # approve a draft, or re-queue a blocked/stuck task (a re-run continues on the same branch)
    t = set_status(a, "ready", ["draft", "blocked", "in_progress"], "ready", {"reason": ""})
    if t and not a["no_dispatch"]:
        out(*(sync() or ["dispatch: nothing to start"]))


def cmd_done(a):
    set_status(a, "done", ["draft", "ready", "in_progress", "review", "blocked"], "done")


COMMANDS = {
    # name: (handler, positional args, flags(name -> takes_value), help)
    "sync": (cmd_sync, [], {}, "task sync  # read PRs from GitHub, then start runs for ready tasks (also done by `task`)"),
    "list": (cmd_list, [], {"status": True}, "task list [--status draft|ready|in_progress|review|blocked|done]  # no GitHub calls"),
    "show": (cmd_show, ["id"], {"full": False}, "task show <id> [--full]"),
    "new": (cmd_new, [], {"title": True, "repo": True, "theme": True, "goal": True, "goal-file": True},
            'task new --title "..." --repo owner/name [--theme x] (--goal "..." | --goal-file path)  # creates a draft'),
    "ready": (cmd_ready, ["id"], {"no-dispatch": False},
              "task ready <id> [--no-dispatch]  # approve a draft, or re-queue a blocked/stuck task"),
    "done": (cmd_done, ["id"], {}, "task done <id>  # close or cancel by hand (a merged PR closes it automatically)"),
}


def main(argv):
    if argv in (["-v"], ["-V"], ["--version"]):
        print(VERSION)
        return
    if not argv:
        return cmd_home(None)
    if argv[0] in ("-h", "--help", "help"):
        out("commands:", "  task  # sync, then show the board", *("  " + c[3] for c in COMMANDS.values()))
        return
    name, rest = argv[0], argv[1:]
    if name in ("claim", "review", "block", "dispatch"):
        fail(f"`{name}` was removed in 0.2: agents no longer write to the board",
             "statuses now come from the agent's PR; run `task sync`", 2)
    if name not in COMMANDS:
        fail(f"unknown command {name!r}", "commands: " + ", ".join(COMMANDS), 2)
    handler, positional, flags, usage = COMMANDS[name]
    if "--help" in rest:
        out(f"usage: {usage}")
        return
    a = {f.replace("-", "_"): (None if takes else False) for f, takes in flags.items()}
    pos = []
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok.startswith("--"):
            f = tok[2:]
            if f not in flags:
                fail(f"unknown flag {tok} for `{name}`", f"usage: {usage}", 2)
            if flags[f]:
                if i + 1 >= len(rest):
                    fail(f"{tok} needs a value", f"usage: {usage}", 2)
                a[f.replace("-", "_")] = rest[i + 1]
                i += 1
            else:
                a[f.replace("-", "_")] = True
        else:
            pos.append(tok)
        i += 1
    if len(pos) != len(positional):
        fail(f"`{name}` takes {len(positional)} argument(s), got {len(pos)}", f"usage: {usage}", 2)
    a.update(zip(positional, pos))
    if a.get("status") and a["status"] not in STATUSES:
        fail(f"unknown status {a['status']!r}", "statuses: " + ", ".join(STATUSES), 2)
    handler(a)


if __name__ == "__main__":
    main(sys.argv[1:])
