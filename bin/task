#!/usr/bin/env python3
"""task - run coding agents on the tasks of a GitHub Project board. The code is task_hub.py beside this file.

Only a launcher: Python keeps no bytecode for a script whose name has no .py, so it would compile all of task_hub.py
at every start. Imported, task_hub.py's bytecode is kept in __pycache__ beside it and used while the file is
unchanged; where that folder cannot be written (a read-only clone, [sandbox]'s agent user), it is compiled at every
start, as before. Nothing else goes here: this file is compiled at every start.
"""
import importlib.util
import os
import sys

# the release (docs/release.md); task_hub.py reads it from here, as does `task update` of a release before the launcher
VERSION = "0.14.0"

if __name__ == "__main__":
    if os.name == "nt" and not sys.flags.utf8_mode:  # files and pipes would be read in the ANSI code page (cp932)
        import subprocess
        # -X utf8 for this child, which holds even where the environment is ignored; PYTHONUTF8 for what it starts
        utf8 = subprocess.Popen([sys.executable, "-X", "utf8", *sys.argv], env={**os.environ, "PYTHONUTF8": "1"})
        while True:
            try:
                sys.exit(utf8.wait())
            except KeyboardInterrupt:  # the console sent Ctrl-C to both: the UTF-8 one handles it, this one waits
                pass
    spec = importlib.util.spec_from_file_location(
        "task_hub", os.path.join(os.path.dirname(os.path.realpath(__file__)), "task_hub.py"))
    task_hub = sys.modules["task_hub"] = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(task_hub)  # a SourceFileLoader: reads and writes __pycache__
    task_hub.main(sys.argv[1:])
